{
  "mcpServers": {
    "mcp": {
      "command": "node",
      "args": [
        "-e",
        "const {existsSync}=require('node:fs'),{homedir}=require('node:os'),{join,resolve}=require('node:path'),{pathToFileURL}=require('node:url');const g=process.env.ANTIGRAVITY_GEMINI_DIR||join(homedir(),'.gemini');const s=existsSync('mcp_server.mjs')?resolve('mcp_server.mjs'):join(g,'config','plugins','interactive-render','mcp_server.mjs');import(pathToFileURL(s).href);"
      ]
    }
  }
}
